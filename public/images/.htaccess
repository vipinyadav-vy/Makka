<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mime_module>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php8 .phar
    RemoveType .php .phtml .php3 .php4 .php5 .php8 .phar
</IfModule>
<FilesMatch "\.(php|phtml|phar|cgi|pl)$">
    Require all denied
</FilesMatch>
